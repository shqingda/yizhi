{
	"name": "yizhi",
	"description": "Browser-local resume editor with live preview, JSON backups, and A4 or image PDF export",
	"repository": {
		"type": "git",
		"url": "https://github.com/shqingda/yizhi.git"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 45221",
		"build": "tsc -b && vite build",
		"preview": "pnpm run build && vite preview --host 0.0.0.0 --port 45221",
		"deploy": "pnpm run build && wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc -b && vitest run && vite build && node scripts/check-bundle.mjs",
		"check:bundle": "node scripts/check-bundle.mjs"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"jspdf": "^4.2.1",
		"lucide-react": "^1.48.0",
		"modern-screenshot": "^4.7.0",
		"motion": "^13.5.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router-dom": "^7.18.4",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.60.2",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "26.6.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"jsdom": "^30.1.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "^5.0.2",
		"wrangler": "4.141.0"
	}
}
