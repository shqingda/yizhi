{
	"name": "resume-studio",
	"description": "Universal online resume generator — Magic Resume–style editor, public page, and A4 PDF on Cloudflare Workers + D1",
	"repository": {
		"type": "git",
		"url": "https://github.com/shqingda/resume-studio.git"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 45221",
		"build": "tsc -b && vite build",
		"preview": "pnpm run build && vite preview --host 0.0.0.0 --port 45221",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local --yes",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote --yes",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc -b && vitest run && vite build"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.2.6",
		"drizzle-orm": "^0.45.1",
		"hono": "4.13.7",
		"jspdf": "^4.2.1",
		"lucide-react": "^1.45.0",
		"modern-screenshot": "^4.7.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router-dom": "^7.13.0",
		"sonner": "^2.0.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.54.8",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "24.10.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"drizzle-kit": "^0.31.8",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "^5.0.0",
		"wrangler": "4.131.1"
	}
}
