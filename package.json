{
	"name": "resume-studio",
	"description": "Universal online resume generator — Magic Resume–style editor, public page, and A4 PDF on Cloudflare Workers + D1",
	"repository": {
		"type": "git",
		"url": "https://origin.cursor.com/shqingda/resume-studio.git"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 45221",
		"build": "tsc -b && vite build",
		"preview": "pnpm run build && vite preview --host 0.0.0.0 --port 45221",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local --yes",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote --yes",
		"db:studio": "drizzle-kit studio",
		"lint": "eslint .",
		"check": "tsc -b && vite build"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.1",
		"hono": "4.11.1",
		"jspdf": "^4.2.1",
		"lucide-react": "^0.562.0",
		"modern-screenshot": "^4.7.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router-dom": "^7.13.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "^0.31.8",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"wrangler": "4.127.0"
	}
}
